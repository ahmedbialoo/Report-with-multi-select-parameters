// Pre-processed: processReport runs on the AOS with the dialog's contract, so the
// multi-select List parms arrive complete instead of being rebuilt from SSRS parameters.
[SRSReportParameterAttribute(classStr(TMK_LeaseContractSummaryContract))]
class TMK_LeaseContractSummaryDP extends SrsReportDataProviderPreProcessTempDB
{
    TMK_LeaseContractSummaryTmp leaseContractSummaryTmp;

    [SRSReportDataSetAttribute(tableStr(TMK_LeaseContractSummaryTmp))]
    public TMK_LeaseContractSummaryTmp getLeaseContractSummaryTmp()
    {
        select leaseContractSummaryTmp;
        return leaseContractSummaryTmp;
    }

    public void processReport()
    {
        TMK_LeaseContractSummaryContract contract = this.parmDataContract() as TMK_LeaseContractSummaryContract;

        if (!contract)
        {
            throw error("Lease Contract Summary contract is missing.");
        }

        container              statuses = this.statusValues(contract.parmLeaseStatuses());
        QueryRun               queryRun = new QueryRun(this.buildQuery(contract));
        AssetLeaseLeaseDetails leaseDetails;
        AssetLeaseLeaseStatus  leaseStatus;

        while (queryRun.next())
        {
            leaseDetails = queryRun.get(tableNum(AssetLeaseLeaseDetails));
            leaseStatus  = this.leaseStatus(leaseDetails);

            // Status lives on the lease books, so it is filtered here, not in the query.
            if (conLen(statuses) && !conFind(statuses, enum2int(leaseStatus)))
            {
                continue;
            }

            leaseContractSummaryTmp.clear();

            leaseContractSummaryTmp.LegalEntity      = leaseDetails.DataAreaId;
            leaseContractSummaryTmp.LeaseId          = leaseDetails.LeaseId;
            leaseContractSummaryTmp.ContractNum      = leaseDetails.TMK_OriginalLeaseContractNum;
            leaseContractSummaryTmp.LeaseDescription = leaseDetails.LeaseDescription;
            leaseContractSummaryTmp.VendAccount      = leaseDetails.VendAccount;
            leaseContractSummaryTmp.VendName         = VendTable::find(leaseDetails.VendAccount).name();
            leaseContractSummaryTmp.LeaseStartDate   = leaseDetails.LeaseStartDate;
            leaseContractSummaryTmp.LeaseEndDate     = leaseDetails.ExpirationDate;
            leaseContractSummaryTmp.LeaseTermMonths  = leaseDetails.MonthsOfUsefulLife;
            leaseContractSummaryTmp.PaymentFrequency = this.paymentFrequency(leaseDetails.LeaseId);
            leaseContractSummaryTmp.ContractValue    = leaseDetails.FairValueOfAsset;
            leaseContractSummaryTmp.CurrencyCode     = leaseDetails.CurrencyCode;
            // Label text ("Not yet acquired", "Open"...), not the enum symbol.
            leaseContractSummaryTmp.LeaseStatus      = enum2Str(leaseStatus);

            leaseContractSummaryTmp.insert();
        }
    }

    private Query buildQuery(TMK_LeaseContractSummaryContract _contract)
    {
        Query                query = new Query();
        QueryBuildDataSource qbdsLease;

        qbdsLease = query.addDataSource(tableNum(AssetLeaseLeaseDetails));
        qbdsLease.addSortField(fieldNum(AssetLeaseLeaseDetails, LeaseId));

        // Lease headers only; book records ("LEASE:BOOK") have a master lease.
        qbdsLease.addRange(fieldNum(AssetLeaseLeaseDetails, MasterLeaseRecId)).value(queryValue(0));

        // Lease ID / Vendor account: one range per selected value (OR'ed)
        this.addListRanges(qbdsLease, fieldNum(AssetLeaseLeaseDetails, LeaseId),     _contract.parmLeaseIds());
        this.addListRanges(qbdsLease, fieldNum(AssetLeaseLeaseDetails, VendAccount), _contract.parmVendAccounts());

        // Lease start date: on or after; lease end date: on or before (blank = no limit)
        if (_contract.parmLeaseStartDate())
        {
            qbdsLease.addRange(fieldNum(AssetLeaseLeaseDetails, LeaseStartDate)).value(
                SysQuery::range(_contract.parmLeaseStartDate(), dateNull()));
        }

        if (_contract.parmLeaseEndDate())
        {
            qbdsLease.addRange(fieldNum(AssetLeaseLeaseDetails, ExpirationDate)).value(
                SysQuery::range(dateNull(), _contract.parmLeaseEndDate()));
        }

        return query;
    }

    /// <summary>
    /// Returns the lease status from the first book of the lease
    /// (Books > Lease status), or the header status when there are no books.
    /// </summary>
    private AssetLeaseLeaseStatus leaseStatus(AssetLeaseLeaseDetails _leaseDetails)
    {
        AssetLeaseLeaseDetails leaseBook;

        select firstonly LeaseStatus from leaseBook
            order by RecId
            where leaseBook.MasterLeaseRecId == _leaseDetails.RecId;

        return leaseBook.RecId ? leaseBook.LeaseStatus : _leaseDetails.LeaseStatus;
    }

    /// <summary>
    /// Returns the payment frequency label of the first payment schedule line.
    /// </summary>
    private Name paymentFrequency(AssetLeaseLeaseId _leaseId)
    {
        AssetLeasePaymentScheduleContract paymentScheduleContract;

        select firstonly Frequency from paymentScheduleContract
            order by StartDate, RecId
            where paymentScheduleContract.LeaseId == _leaseId;

        return paymentScheduleContract.RecId ? enum2Str(paymentScheduleContract.Frequency) : '';
    }

    private void addListRanges(QueryBuildDataSource _qbds, FieldId _fieldId, List _values)
    {
        container values = this.listValues(_values);
        int       i;

        for (i = 1; i <= conLen(values); i++)
        {
            _qbds.addRange(_fieldId).value(queryValue(conPeek(values, i)));
        }
    }

    /// <summary>
    /// Converts the selected statuses (enum labels or symbols) into a container of enum values.
    /// Empty = all statuses.
    /// </summary>
    private container statusValues(List _statuses)
    {
        container tokens = this.listValues(_statuses);
        container result;
        int       i;

        for (i = 1; i <= conLen(tokens); i++)
        {
            int statusValue = this.findLeaseStatus(conPeek(tokens, i));

            if (statusValue != -1 && !conFind(result, statusValue))
            {
                result += statusValue;
            }
        }

        return result;
    }

    /// <summary>
    /// Converts a multi-select List into a container, trimming blanks and skipping empty entries.
    /// An entry that still holds "A;B" is split as well. Null or empty list = no filter.
    /// </summary>
    private container listValues(List _values)
    {
        container       result;
        ListEnumerator  enumerator;

        if (!_values)
        {
            return result;
        }

        enumerator = _values.getEnumerator();

        while (enumerator.moveNext())
        {
            container raw = str2con(enumerator.current(), ';', false);
            int       i;

            for (i = 1; i <= conLen(raw); i++)
            {
                str value = strLRTrim(conPeek(raw, i));
                if (value && !conFind(result, value))
                {
                    result += value;
                }
            }
        }

        return result;
    }

    /// <summary>
    /// Returns the AssetLeaseLeaseStatus value matching an enum label ("Not yet acquired")
    /// or symbol ("NotYetAcquired"), or -1 if nothing matches.
    /// </summary>
    private int findLeaseStatus(str _token)
    {
        DictEnum dictEnum = new DictEnum(enumNum(AssetLeaseLeaseStatus));
        str      token    = this.normalize(_token);
        int      i;

        if (!token)
        {
            return -1;
        }

        for (i = 0; i < dictEnum.values(); i++)
        {
            if (token == this.normalize(dictEnum.index2Label(i))
             || token == this.normalize(dictEnum.index2Symbol(i)))
            {
                return dictEnum.index2Value(i);
            }
        }

        return -1;
    }

    private str normalize(str _value)
    {
        // Ignore case, spaces, tabs and line breaks.
        return strLwr(strRem(_value, ' \t\r\n'));
    }

}
