class TMK_LeasePaymentsDuePaidUIBuilder extends SrsReportDataContractUIBuilder
{
    TMK_LeasePaymentsDuePaidContract contract;
    DialogField                      leaseIdsField;
    DialogField                      vendAccountsField;
    DialogField                      invoiceIdField;
    DialogField                      currencyCodesField;

    public void postBuild()
    {
        super();

        contract = this.dataContractObject() as TMK_LeasePaymentsDuePaidContract;

        leaseIdsField = this.bindInfo().getDialogField(
            contract,
            methodStr(TMK_LeasePaymentsDuePaidContract, parmLeaseIds));

        vendAccountsField = this.bindInfo().getDialogField(
            contract,
            methodStr(TMK_LeasePaymentsDuePaidContract, parmVendAccounts));

        invoiceIdField = this.bindInfo().getDialogField(
            contract,
            methodStr(TMK_LeasePaymentsDuePaidContract, parmInvoiceId));

        currencyCodesField = this.bindInfo().getDialogField(
            contract,
            methodStr(TMK_LeasePaymentsDuePaidContract, parmCurrencyCodes));

        if (leaseIdsField)
        {
            leaseIdsField.registerOverrideMethod(
                methodStr(FormStringControl, lookup),
                methodStr(TMK_LeasePaymentsDuePaidUIBuilder, lookupLeaseIds),
                this);
            leaseIdsField.lookupButton(FormLookupButton::Always);
        }

        if (vendAccountsField)
        {
            vendAccountsField.registerOverrideMethod(
                methodStr(FormStringControl, lookup),
                methodStr(TMK_LeasePaymentsDuePaidUIBuilder, lookupVendAccounts),
                this);
            vendAccountsField.lookupButton(FormLookupButton::Always);
        }

        if (invoiceIdField)
        {
            invoiceIdField.registerOverrideMethod(
                methodStr(FormStringControl, lookup),
                methodStr(TMK_LeasePaymentsDuePaidUIBuilder, lookupInvoiceId),
                this);
            invoiceIdField.lookupButton(FormLookupButton::Always);
        }

        if (currencyCodesField)
        {
            currencyCodesField.registerOverrideMethod(
                methodStr(FormStringControl, lookup),
                methodStr(TMK_LeasePaymentsDuePaidUIBuilder, lookupCurrencyCodes),
                this);
            currencyCodesField.lookupButton(FormLookupButton::Always);
        }
    }

    public void postRun()
    {
        // super() is not called on purpose: it would attach the framework's own multi-select
        // lookup to the List parms and register 'lookup' a second time on the same controls.
        // The lookups are registered in postBuild instead.
        //super();
    }

    // ---------- Lookup overrides ----------
    // The same control is passed as calling control, Ids and Strs, so the
    // selected values are written back as "A;B;C" into the dialog field.

    public void lookupLeaseIds(FormStringControl _control)
    {
        SysLookupMultiSelectGrid::lookup(
            this.leaseLookupQuery(),
            _control,
            _control,
            _control,
            [tableNum(AssetLeaseLeaseDetails), fieldNum(AssetLeaseLeaseDetails, LeaseId)]);
    }

    public void lookupVendAccounts(FormStringControl _control)
    {
        SysLookupMultiSelectGrid::lookup(
            this.vendLookupQuery(),
            _control,
            _control,
            _control,
            [tableNum(VendTable), fieldNum(VendTable, AccountNum)]);
    }

    public void lookupCurrencyCodes(FormStringControl _control)
    {
        SysLookupMultiSelectGrid::lookup(
            this.currencyLookupQuery(),
            _control,
            _control,
            _control,
            [tableNum(Currency), fieldNum(Currency, CurrencyCode)]);
    }

    /// <summary>
    /// Single-value lookup of posted vendor invoices, limited to the selected vendors.
    /// </summary>
    public void lookupInvoiceId(FormStringControl _control)
    {
        SysTableLookup       sysTableLookup = SysTableLookup::newParameters(tableNum(VendTrans), _control);
        Query                query          = new Query();
        QueryBuildDataSource qbds           = query.addDataSource(tableNum(VendTrans));
        container            vendAccounts   = str2con(vendAccountsField ? vendAccountsField.value() : '', ';', false);
        int                  i;

        qbds.addRange(fieldNum(VendTrans, Invoice)).value(SysQuery::valueNotEmptyString());
        qbds.addRange(fieldNum(VendTrans, AmountCur)).value('<0'); // invoices, not credit notes or payments
        qbds.addSortField(fieldNum(VendTrans, TransDate), SortOrder::Descending);

        for (i = 1; i <= conLen(vendAccounts); i++)
        {
            str vendAccount = strLRTrim(conPeek(vendAccounts, i));
            if (vendAccount)
            {
                qbds.addRange(fieldNum(VendTrans, AccountNum)).value(queryValue(vendAccount));
            }
        }

        sysTableLookup.addLookupfield(fieldNum(VendTrans, Invoice), true);
        sysTableLookup.addLookupfield(fieldNum(VendTrans, AccountNum));
        sysTableLookup.addLookupfield(fieldNum(VendTrans, TransDate));
        sysTableLookup.addLookupfield(fieldNum(VendTrans, Voucher));
        sysTableLookup.addLookupfield(fieldNum(VendTrans, CurrencyCode));
        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

    // ---------- Lookup queries ----------
    // The grid shows exactly the fields in each field list, so the lists are
    // cleared first; otherwise every table field becomes a column.

    private Query leaseLookupQuery()
    {
        Query                query = new Query();
        QueryBuildDataSource qbds  = query.addDataSource(tableNum(AssetLeaseLeaseDetails));

        // Lease headers only; book records ("LEASE:BOOK") have a master lease.
        qbds.addRange(fieldNum(AssetLeaseLeaseDetails, MasterLeaseRecId)).value(queryValue(0));
        qbds.addSortField(fieldNum(AssetLeaseLeaseDetails, LeaseId));

        qbds.fields().dynamic(NoYes::No);
        qbds.fields().clearFieldList();
        qbds.fields().addField(fieldNum(AssetLeaseLeaseDetails, LeaseId));
        qbds.fields().addField(fieldNum(AssetLeaseLeaseDetails, LeaseDescription));
        qbds.fields().addField(fieldNum(AssetLeaseLeaseDetails, VendAccount));

        return query;
    }

    private Query vendLookupQuery()
    {
        Query                query = new Query();
        QueryBuildDataSource qbds  = query.addDataSource(tableNum(VendTable));
        QueryBuildDataSource qbdsParty;

        qbds.addSortField(fieldNum(VendTable, AccountNum));
        qbds.fields().dynamic(NoYes::No);
        qbds.fields().clearFieldList();
        qbds.fields().addField(fieldNum(VendTable, AccountNum));

        // Vendor name
        qbdsParty = qbds.addDataSource(tableNum(DirPartyTable));
        qbdsParty.joinMode(JoinMode::InnerJoin);
        qbdsParty.addLink(fieldNum(VendTable, Party), fieldNum(DirPartyTable, RecId));
        qbdsParty.fields().dynamic(NoYes::No);
        qbdsParty.fields().clearFieldList();
        qbdsParty.fields().addField(fieldNum(DirPartyTable, Name));

        return query;
    }

    private Query currencyLookupQuery()
    {
        Query                query = new Query();
        QueryBuildDataSource qbds  = query.addDataSource(tableNum(Currency));

        qbds.addSortField(fieldNum(Currency, CurrencyCode));
        qbds.fields().dynamic(NoYes::No);
        qbds.fields().clearFieldList();
        qbds.fields().addField(fieldNum(Currency, CurrencyCode));
        qbds.fields().addField(fieldNum(Currency, Txt));

        return query;
    }

}
